# Resend API key used by the contact form — https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that contact-form submissions are delivered to
CONTACT_TO_EMAIL=

# Verified "from" address. Leave blank to use Resend's onboarding@resend.dev (test mode only).
CONTACT_FROM_EMAIL=

# Public site URL — used for metadata, sitemap and robots
NEXT_PUBLIC_SITE_URL=
